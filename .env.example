# ─────────────────────────────────────────────────────────────────────────────
# KshetraIQ — Root .env.example
# Copy to .env and fill in values. All keys are optional; services fall back
# to safe offline benchmarks when omitted.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# Values: development | production
KSHETRAIQ_ENVIRONMENT=development

# ── Model Directory ───────────────────────────────────────────────────────────
# Path to trained model artifact directory (relative to repo root or absolute)
# Default: Agriverse_Models
KSHETRAIQ_MODEL_DIRECTORY=Agriverse_Models

# ── Storage Backend ───────────────────────────────────────────────────────────
# Options: sqlite | supabase | memory
KSHETRAIQ_STORAGE_BACKEND=sqlite
# Local development default: backend/.tmp/kshetraiq.db
# Render with Persistent Disk: /var/data/kshetraiq.db (requires paid persistent disk mounted at /var/data)
# Render Free / Ephemeral default: /tmp/kshetraiq/kshetraiq.db (writable temp directory)
# NOTE: /tmp storage is temporary and may be lost when the service restarts or redeploys.
KSHETRAIQ_SQLITE_PATH=backend/.tmp/kshetraiq.db

# Optional Cache and Upload Custom Paths
# KSHETRAIQ_CACHE_DB_PATH=/tmp/kshetraiq/kshetraiq.db
# KSHETRAIQ_UPLOAD_DIR=/tmp/kshetraiq/uploads
# KSHETRAIQ_DATA_DIR=/tmp/kshetraiq

# ── Supabase (Optional — for cloud persistence) ───────────────────────────────
# If omitted, falls back to local SQLite
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── LLM / AI Advisor (Optional — for chatbot and farm advisory) ───────────────
# At least one key needed for AI chatbot. If omitted, advisory uses rule-based fallback.
# GEMINI_API_KEY=your-gemini-api-key
# GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=your-openai-api-key
# LLM_PROVIDER=gemini                # Options: gemini | groq | openai | custom

# ── AGMARKNET / data.gov.in Mandi Feed (Optional) ────────────────────────────
# If omitted, market price endpoint uses last verified AGMARKNET benchmark (2023-12-30)
# Register free at: https://data.gov.in/user/register
# Resource: https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
# DATA_GOV_IN_API_KEY=your-data-gov-in-api-key

# ── Upload Size Limit ──────────────────────────────────────────────────────────
# Maximum upload file size in bytes (default: 10 MB)
# KSHETRAIQ_MAX_UPLOAD_BYTES=10485760

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# KSHETRAIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Authentication / Google OAuth ──────────────────────────────────────────
# Keep the client secret in the local ignored .env file only.  In Google Cloud,
# register this exact redirect URI when using the frontend callback architecture.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# SESSION_EXPIRY_HOURS=24
# PERSISTENT_SESSION_DAYS=30

# ── Password recovery email ─────────────────────────────────────────────────
# Development defaults to EMAIL_PROVIDER=console and logs the reset link only
# in the backend terminal. Production needs a real SMTP provider.
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# PASSWORD_RESET_EXPIRY_MINUTES=30

# ── Google Earth Engine (Satellite Intelligence Module) ──────────────────────
# Default project ID from capstone-final/satellitle_part.ipynb: able-pottery-463117-r0
# For local development: run `earthengine authenticate` in the CLI.
# For production or headless environments: specify service account credentials.
EARTH_ENGINE_PROJECT=able-pottery-463117-r0
# EARTH_ENGINE_SERVICE_ACCOUNT=your-gee-service-account@able-pottery-463117-r0.iam.gserviceaccount.com
# EARTH_ENGINE_CREDENTIALS_PATH=backend/credentials/earth_engine_service_account.json
# Note: Earth Engine credentials are kept strictly private on the backend.
# The interactive India map operates with full geometry/location picking even
# if Earth Engine credentials are unconfigured (truthful REQUIRES_CREDENTIALS state).
