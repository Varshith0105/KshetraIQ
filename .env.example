# ─────────────────────────────────────────────────────────────────────────────
# KshetraIQ — Root .env.example
# Copy to .env and fill in values. All keys are optional; services fall back
# to safe offline benchmarks when omitted.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# Values: development | production
KSHETRAIQ_ENVIRONMENT=development

# ── Model Directory ───────────────────────────────────────────────────────────
# Path to trained model artifact directory (relative to repo root or absolute)
# Default: Agriverse_Models
KSHETRAIQ_MODEL_DIRECTORY=Agriverse_Models

# ── Storage Backend ───────────────────────────────────────────────────────────
# Options: sqlite | supabase | memory
KSHETRAIQ_STORAGE_BACKEND=sqlite
# SQLite database file path (relative to repo root)
KSHETRAIQ_SQLITE_PATH=backend/.tmp/kshetraiq.db

# ── Supabase (Optional — for cloud persistence) ───────────────────────────────
# If omitted, falls back to local SQLite
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── LLM / AI Advisor (Optional — for chatbot and farm advisory) ───────────────
# At least one key needed for AI chatbot. If omitted, advisory uses rule-based fallback.
# GEMINI_API_KEY=your-gemini-api-key
# GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=your-openai-api-key
# LLM_PROVIDER=gemini                # Options: gemini | groq | openai | custom

# ── AGMARKNET / data.gov.in Mandi Feed (Optional) ────────────────────────────
# If omitted, market price endpoint uses last verified AGMARKNET benchmark (2023-12-30)
# Register free at: https://data.gov.in/user/register
# Resource: https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
# DATA_GOV_IN_API_KEY=your-data-gov-in-api-key

# ── Upload Size Limit ──────────────────────────────────────────────────────────
# Maximum upload file size in bytes (default: 10 MB)
# KSHETRAIQ_MAX_UPLOAD_BYTES=10485760

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# KSHETRAIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
