# ─────────────────────────────────────────────────────────────────────────────
# KshetraIQ Backend — backend/.env.example
# Symlink or copy to backend/.env (or set in root .env at repo root).
# All keys are optional; every service runs safely with local offline fallbacks.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime Environment ────────────────────────────────────────────────────────
# Options: development | production
KSHETRAIQ_ENVIRONMENT=development

# ── Model Directory ───────────────────────────────────────────────────────────
# Relative to repo root, or absolute path
KSHETRAIQ_MODEL_DIRECTORY=Agriverse_Models

# ── Storage ───────────────────────────────────────────────────────────────────
# Options: sqlite (default) | supabase | memory
KSHETRAIQ_STORAGE_BACKEND=sqlite
KSHETRAIQ_SQLITE_PATH=backend/.tmp/kshetraiq.db

# ── Supabase Cloud Database (Optional) ────────────────────────────────────────
# Omit entirely to use local SQLite. Required only for multi-server deployments.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5...

# ── LLM / AI Advisory Chatbot (Optional) ─────────────────────────────────────
# Any one key enables AI-powered farm advisory. Tried in order: Gemini > Groq > OpenAI.
# When absent, rule-based advisory engine activates automatically.
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=gemini

# ── AGMARKNET Real-Time Mandi Data Feed (Optional) ────────────────────────────
# Powers live daily wholesale price in market-price-v1 model.
# When absent: uses AGMARKNET verified benchmark observation (2023-12-30, Rs.2275/Quintal).
# Register free at: https://data.gov.in/user/register
# API Resource: 9ef84268-d588-465a-a308-a864a43d0070
# DATA_GOV_IN_API_KEY=your-data-gov-in-api-key

# ── Upload Limits ─────────────────────────────────────────────────────────────
# Maximum allowed upload size in bytes (10 MB default)
# KSHETRAIQ_MAX_UPLOAD_BYTES=10485760

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your production frontend origin if deploying
# KSHETRAIQ_CORS_ORIGINS=https://kshetraiq.com,http://localhost:3000
